        "ms": "250|1000"
      },
      "response": "ok"
    },
    {
      "method": "POST",
      "path": "/api/target",
      "query": {
        "host": "IPv4 or DNS hostname",
        "port": "optional TCP port 1..65535"
      },
      "response": "ok"
    },
    {
      "method": "POST",
      "path": "/api/target/remove",
      "query": {
        "address": "IPv4"
      },
      "response": "ok"
    },
    {
