  "measurementSemantics": {
    "icmpTimeoutMs": 1200,
    "icmpIntervalsMs": [
      250,
      1000
    ],
    "tcpIntervalMs": 5000,
    "adapterIntervalMs": 500,
    "historySeconds": 300,
    "lossDenominator": "completed non-tool-error probes; pending probes excluded",
    "jitter": "mean absolute RTT difference between adjacent successful probes, reset by unanswered probe",
    "sessionP95": "1ms histogram, nearest rank; clamp at 10000ms",
    "windowP95": "nearest rank over successful RTTs",
    "neverRespondingDiagnosticLoss": null,
    "diagnosisMaxConcurrent": 4,
    "routeMaxConcurrent": 2,
    "diagnosisDurationSeconds": 120,
    "etwDurationSeconds": 20,
    "etwPurpose": "detect active UDP peer; does not measure gameplay packet loss"
  },
  "storage": {
    "encoding": "UTF-8, accept optional BOM on legacy files",
    "csv": {
      "probes.csv": "time,unix_ms,adapter,source_ip,interface_index,protocol,target,port,ok,status,rtt_ms,tool_error",
      "adapters.csv": "time,elapsed_ms,adapter,index,state,ipv4,gateway,speed_mbps,rx_errors,tx_errors,rx_discards,tx_discards",
      "diagnostic-probes.csv": "event_time,sent_time,target_id,protocol,address,source_ip,interface_index,payload_bytes,status,rtt_ms,scheduler_lag_ms",
      "radio.csv": "time,statisticsError,rssiDbm,qualityPct,txRateNative,rxRateNative,txFrames,retryFrames,multipleRetryFrames,failedFrames,ackFailure,fcsErrors",
      "ethernet.csv": "time,elapsed_ms,state,speed_mbps,rx_errors,tx_errors,rx_discards,tx_discards,counters_available,adapter_found,error",
      "controlled-udp-probes.csv": "event_time,sent_time,sequence,status,rtt_ms,source_ip,interface_index,server,port"
    },
    "identity": {
      "log-store.json": {
        "appId": "codex-internet-stability",
        "version": 1
      },
      "status.json": {
        "appId": "codex-internet-stability"
      },
      "diagnosis-runs/<id>/run.json": {
        "appId": "codex-network-diagnosis-run"
      },
      "diagnostics-live.json": {
        "appId": "codex-single-pc-diagnostics"
      },
      "radio-live.json": {
        "kind": "wifi_radio",
        "schemaVersion": 1
      },
      "ethernet-live.json": {
        "kind": "ethernet_line",
        "schemaVersion": 1
      },
      "routes/*.json": {
        "appId": "codex-internet-stability-route"
      },
      "capture.json": {
        "appId": "codex-cod-relay-capture"
      }
    },
    "events": "events.jsonl: one event object per line",
    "compatibility": "append to valid legacy CSV; replay complete history and skip damaged rows with warning; read legacy diagnostic directories and current diagnosis-runs",
    "deletion": "only owned files inside confirmed current store, reject symlinks/reparse points and active runs",
    "runtimeChange": "diagnosis workers are Go goroutines in the backend PID; runtime.json is private lifecycle metadata, not a panel response"
  }
}
