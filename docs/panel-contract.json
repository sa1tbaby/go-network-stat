  "dashboardLanguage": "en",
  "transport": {
    "host": "127.0.0.1",
    "defaultPort": 8765,
    "portAttempts": 20,
    "sameOrigin": true,
    "jsonCase": "camelCase",
    "dates": "ISO 8601/RFC3339 with UTC offset; timestamps denote the same instant",
    "historyTimestamp": "Unix milliseconds",
    "emptyArrays": [],
    "unknownNumbers": null,
    "commandError": {
      "status": 400,
      "json": {
        "error": "non-empty human-readable message"
      }
    },
    "foreignOrigin": 403,
    "unknownEndpoint": 404
  },
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "response": "asset dashboard.html"
    },
    {
      "method": "GET",
      "path": "/dashboard.html",
      "response": "asset dashboard.html"
    },
