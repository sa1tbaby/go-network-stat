    },
    {
      "method": "POST",
      "path": "/api/cs2/relay/start",
      "query": {},
      "response": "relayStart"
    },
    {
      "method": "POST",
      "path": "/api/route/start",
      "query": {
        "adapterId": "exact adapter ID",
        "address": "existing ICMP target IPv4"
      },
      "response": "routeStart"
    },
    {
      "method": "POST",
      "path": "/api/logs/pick",
      "query": {},
      "response": "ok"
    },
    {
      "method": "POST",
      "path": "/api/logs/select",
      "query": {
        "path": "absolute directory"
      },
      "response": "storeCommand"
    },
    {
      "method": "POST",
      "path": "/api/logs/reset",
      "query": {
        "directory": "confirmed current directory"
      },
      "response": "storeCommand"
    },
    {
      "method": "POST",
      "path": "/api/diagnostics/start",
      "query": {
        "adapterId": "available source-bound adapter"
      },
      "response": "diagnosisStart"
    },
    {
      "method": "POST",
      "path": "/api/diagnostics/stop",
      "query": {
        "runId": "one run ID"
      },
      "response": "diagnosisStop"
    },
    {
      "method": "POST",
      "path": "/api/diagnostics/delete",
      "query": {
        "runId": "one completed run ID",
        "directory": "confirmed current store"
      },
      "response": "diagnosisDelete"
    }
