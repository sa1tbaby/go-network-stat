    },
    {
      "method": "POST",
      "path": "/api/start",
      "query": {},
      "response": "ok"
    },
    {
      "method": "POST",
      "path": "/api/stop",
      "query": {},
      "response": "ok"
    },
    {
      "method": "POST",
